    AUTORADIOBUTTON "Colour emoji",IDC_LIKE_STYLE_EMOJI,175,101,110,10
    AUTOCHECKBOX    "Own heart colour",IDC_LIKE_COLOR_CUSTOM,15,118,80,10
    CONTROL         "",IDC_LIKE_SWATCH,"Static",SS_OWNERDRAW,96,117,22,12
    PUSHBUTTON      "Choose...",IDC_LIKE_COLOR,122,116,44,14
