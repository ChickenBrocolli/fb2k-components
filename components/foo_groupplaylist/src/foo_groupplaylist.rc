#include "resource.h"
#include "winres.h"

#pragma code_page(65001)

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_COLUMNS_PAGE DIALOGEX 0, 0, 332, 214
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Ticked columns show in the panel header's Columns menu, in this order. Built-in columns cannot be removed.",IDC_STATIC,7,4,318,8,SS_NOPREFIX
    CONTROL         "",IDC_COLUMN_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,7,16,252,112
    PUSHBUTTON      "Add",IDC_COLUMN_NEW,265,16,60,14
    PUSHBUTTON      "Duplicate",IDC_COLUMN_DUPLICATE,265,33,60,14
    PUSHBUTTON      "Remove",IDC_COLUMN_DELETE,265,50,60,14
    PUSHBUTTON      "Move up",IDC_COLUMN_UP,265,73,60,14
    PUSHBUTTON      "Move down",IDC_COLUMN_DOWN,265,90,60,14
    PUSHBUTTON      "Restore default",IDC_COLUMN_RESTORE,265,113,60,14
    GROUPBOX        "Selected column",IDC_STATIC,7,134,318,76
    LTEXT           "Name",IDC_STATIC,15,150,44,8
    EDITTEXT        IDC_COLUMN_NAME,60,148,120,14,ES_AUTOHSCROLL
    LTEXT           "Alignment",IDC_STATIC,192,150,40,8
    COMBOBOX        IDC_COLUMN_ALIGN,235,148,82,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Pattern",IDC_STATIC,15,170,44,8
    EDITTEXT        IDC_COLUMN_PATTERN,60,168,197,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Insert field",IDC_COLUMN_INSERT,261,168,56,14
    CONTROL         "",IDC_COLUMN_PREVIEW,"Static",SS_OWNERDRAW | SS_NOPREFIX,60,188,195,16
    CONTROL         "Syntax help",IDC_COLUMN_SYNTAX,"Static",SS_LEFTNOWORDWRAP | SS_NOTIFY | WS_TABSTOP,263,188,54,10
END

IDD_PREFERENCES DIALOGEX 0, 0, 332, 282
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Fonts",IDC_STATIC,7,4,318,40
    AUTOCHECKBOX    "Own font for tracks",IDC_PREF_TRACK_FONT_CUSTOM,15,16,100,10
    PUSHBUTTON      "Choose...",IDC_PREF_TRACK_FONT_BUTTON,120,14,50,14
    LTEXT           "",IDC_PREF_TRACK_FONT_NAME,176,17,145,8,SS_NOPREFIX | SS_ENDELLIPSIS
    AUTOCHECKBOX    "Own font for group headers",IDC_PREF_HEADER_FONT_CUSTOM,15,31,100,10
    PUSHBUTTON      "Choose...",IDC_PREF_HEADER_FONT_BUTTON,120,29,50,14
    LTEXT           "",IDC_PREF_HEADER_FONT_NAME,176,32,145,8,SS_NOPREFIX | SS_ENDELLIPSIS
    GROUPBOX        "Colours and sizes",IDC_STATIC,7,48,318,46
    AUTOCHECKBOX    "Own header colour",IDC_PREF_HEADER_COLOR_CUSTOM,15,61,80,10
    CONTROL         "",IDC_PREF_HEADER_SWATCH,"Static",SS_OWNERDRAW,96,60,22,12
    PUSHBUTTON      "Choose...",IDC_PREF_HEADER_COLOR,122,59,44,14
    AUTOCHECKBOX    "Own label colour",IDC_PREF_LABEL_COLOR_CUSTOM,172,61,72,10
    CONTROL         "",IDC_PREF_LABEL_SWATCH,"Static",SS_OWNERDRAW,245,60,22,12
    PUSHBUTTON      "Choose...",IDC_PREF_LABEL_COLOR,271,59,44,14
    LTEXT           "Extra row height",IDC_STATIC,15,78,72,8
    EDITTEXT        IDC_PREF_ROW_PADDING,88,76,36,13,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_PREF_ROW_PADDING_SPIN,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,124,76,10,13
    LTEXT           "Album art size",IDC_STATIC,170,78,72,8
    EDITTEXT        IDC_PREF_COVER_SIZE,243,76,36,13,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_PREF_COVER_SIZE_SPIN,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,279,76,10,13
    LTEXT           "px",IDC_STATIC,128,78,20,8
    LTEXT           "px",IDC_STATIC,283,78,20,8
    GROUPBOX        "Language and text",IDC_STATIC,7,98,318,30
    LTEXT           "Language:",IDC_STATIC,15,112,40,8
    COMBOBOX        IDC_PREF_LANGUAGE,58,110,95,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Text rendering:",IDC_STATIC,165,112,55,8
    COMBOBOX        IDC_PREF_TEXT_RENDERING,222,110,96,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "Behaviour",IDC_STATIC,7,132,318,98
    LTEXT           "Remember per playlist:",IDC_STATIC,15,145,85,8
    AUTOCHECKBOX    "Group preset",IDC_PREF_PRESET_PER_LIST,102,144,64,10
    AUTOCHECKBOX    "Scroll position",IDC_PREF_SCROLL_PER_LIST,168,144,72,10
    AUTOCHECKBOX    "Column layout",IDC_PREF_COLUMNS_PER_LIST,242,144,70,10
    AUTOCHECKBOX    "Show column headers",IDC_PREF_SHOW_HEADERS,15,156,300,10
    AUTOCHECKBOX    "Sort the playlist by clicking a column header",IDC_PREF_SORT_ON_CLICK,15,168,300,10
    AUTOCHECKBOX    "Drag to reorder columns",IDC_PREF_DRAG_COLUMNS,15,180,300,10
    AUTOCHECKBOX    "Dim text in brackets",IDC_PREF_DIM_BRACKETS,15,192,300,10
    AUTOCHECKBOX    "Bold the playing track",IDC_PREF_BOLD_PLAYING,15,204,300,10
    AUTOCHECKBOX    "Show track count and length on",IDC_PREF_TRACK_SUMMARY,15,216,122,10
    COMBOBOX        IDC_PREF_SUMMARY_PLACE,140,214,130,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "Settings file",IDC_STATIC,7,234,318,32
    PUSHBUTTON      "Export settings...",IDC_PREF_EXPORT,15,246,96,14
    PUSHBUTTON      "Import settings...",IDC_PREF_IMPORT,117,246,96,14
END

IDD_GROUPS_PAGE DIALOGEX 0, 0, 332, 270
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Ways to group a playlist. Ticked presets are listed in the Groups menu of the panel header.",IDC_STATIC,7,4,318,8,SS_NOPREFIX
    CONTROL         "",IDC_PRESET_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,7,16,262,78
    PUSHBUTTON      "Add copy",IDC_PRESET_NEW,275,16,50,14
    PUSHBUTTON      "Remove",IDC_PRESET_DELETE,275,33,50,14
    PUSHBUTTON      "Move up",IDC_PRESET_UP,275,56,50,14
    PUSHBUTTON      "Move down",IDC_PRESET_DOWN,275,73,50,14
    CONTROL         "Syntax help",IDC_PRESET_SYNTAX,"Static",SS_LEFTNOWORDWRAP | SS_NOTIFY | WS_TABSTOP,263,240,54,10
    GROUPBOX        "Selected preset",IDC_STATIC,7,98,318,170
    LTEXT           "Name",IDC_STATIC,15,112,44,8
    EDITTEXT        IDC_PRESET_NAME,62,110,255,14,ES_AUTOHSCROLL
    LTEXT           "Group header",IDC_STATIC,15,130,46,8
    EDITTEXT        IDC_PRESET_HEADER,62,128,195,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Insert field",IDC_PRESET_HEADER_INSERT,261,128,56,14
    LTEXT           "Cover",IDC_STATIC,15,148,46,8
    EDITTEXT        IDC_PRESET_COVER,62,146,195,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Insert field",IDC_PRESET_COVER_INSERT,261,146,56,14
    AUTOCHECKBOX    "Show the cover text next to the cover. A | starts a new line.",IDC_PRESET_COVER_TEXT,62,162,255,10
    LTEXT           "Labels",IDC_STATIC,15,178,46,8
    LTEXT           "one per line",IDC_STATIC,15,188,46,8
    EDITTEXT        IDC_PRESET_SUBGROUPS,62,176,195,28,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL
    PUSHBUTTON      "Insert field",IDC_PRESET_SUBGROUP_INSERT,261,176,56,14
    AUTOCHECKBOX    "Hide a label that is the same for the whole group, such as Disc 1",IDC_PRESET_HIDE_UNIFORM,62,207,255,10
    LTEXT           "Sort by",IDC_STATIC,15,223,46,8
    EDITTEXT        IDC_PRESET_SORT,62,221,195,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Insert field",IDC_PRESET_SORT_INSERT,261,221,56,14
    CONTROL         "",IDC_PRESET_PREVIEW,"Static",SS_OWNERDRAW | SS_NOPREFIX,62,238,195,28
END

IDD_SCROLL_PAGE DIALOGEX 0, 0, 332, 263
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "A change on this page shows at once in every panel. Apply keeps it; leaving without Apply goes back.",IDC_STATIC,7,4,318,16,SS_NOPREFIX
    AUTOCHECKBOX    "Pin group headers",IDC_SCROLL_PIN,7,24,300,10
    AUTOCHECKBOX    "Smooth scrolling",IDC_SCROLL_SMOOTH,7,37,300,10
    LTEXT           "Both also switch at once from the menu of a right-click on the column titles.",IDC_STATIC,7,50,318,8,SS_NOPREFIX
    LTEXT           "Preset",IDC_STATIC,19,70,40,8
    COMBOBOX        IDC_SCROLL_PRESET,62,68,184,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Remove",IDC_SCROLL_DELETE,250,68,68,14
    LTEXT           "New name",IDC_STATIC,19,88,40,8
    EDITTEXT        IDC_SCROLL_NEW_NAME,62,86,118,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Save as new",IDC_SCROLL_SAVE_NEW,184,86,62,14
    PUSHBUTTON      "Overwrite",IDC_SCROLL_OVERWRITE,250,86,68,14
    LTEXT           "Glide length",IDC_STATIC,19,111,94,8
    CONTROL         "",IDC_SCROLL_SLIDER_0,"msctls_trackbar32",TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_TABSTOP,114,108,150,14
    EDITTEXT        IDC_SCROLL_VALUE_0,268,109,36,13,ES_AUTOHSCROLL
    LTEXT           "ms",IDC_STATIC,308,111,18,8,SS_NOPREFIX
    LTEXT           "How long the view keeps sliding after a notch. Higher glides longer and softer.",IDC_STATIC,19,124,306,8,SS_NOPREFIX
    LTEXT           "Distance per notch",IDC_STATIC,19,138,94,8
    CONTROL         "",IDC_SCROLL_SLIDER_1,"msctls_trackbar32",TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_TABSTOP,114,135,150,14
    EDITTEXT        IDC_SCROLL_VALUE_1,268,136,36,13,ES_AUTOHSCROLL
    LTEXT           "×",IDC_STATIC,308,138,18,8,SS_NOPREFIX
    LTEXT           "1.00 moves as far as the Windows wheel setting (lines per notch).",IDC_STATIC,19,151,306,8,SS_NOPREFIX
    LTEXT           "Quick-turn time",IDC_STATIC,19,165,94,8
    CONTROL         "",IDC_SCROLL_SLIDER_2,"msctls_trackbar32",TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_TABSTOP,114,162,150,14
    EDITTEXT        IDC_SCROLL_VALUE_2,268,163,36,13,ES_AUTOHSCROLL
    LTEXT           "ms",IDC_STATIC,308,165,18,8,SS_NOPREFIX
    LTEXT           "Notches closer together than this count as a quick turn and speed up.",IDC_STATIC,19,178,306,8,SS_NOPREFIX
    LTEXT           "Speed-up per quick notch",IDC_STATIC,19,192,94,8
    CONTROL         "",IDC_SCROLL_SLIDER_3,"msctls_trackbar32",TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_TABSTOP,114,189,150,14
    EDITTEXT        IDC_SCROLL_VALUE_3,268,190,36,13,ES_AUTOHSCROLL
    LTEXT           "How much harder each quick notch in a row pushes. 0 turns the speed-up off.",IDC_STATIC,19,205,306,8,SS_NOPREFIX
    LTEXT           "Maximum speed-up",IDC_STATIC,19,219,94,8
    CONTROL         "",IDC_SCROLL_SLIDER_4,"msctls_trackbar32",TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_TABSTOP,114,216,150,14
    EDITTEXT        IDC_SCROLL_VALUE_4,268,217,36,13,ES_AUTOHSCROLL
    LTEXT           "×",IDC_STATIC,308,219,18,8,SS_NOPREFIX
    LTEXT           "A push never grows past this many times a single notch.",IDC_STATIC,19,232,306,8,SS_NOPREFIX
    PUSHBUTTON      "Reset to defaults",IDC_SCROLL_RESET,19,245,90,14
END

IDD_RATING_PAGE DIALOGEX 0, 0, 332, 140
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Where they are kept",IDC_STATIC,7,4,318,46
