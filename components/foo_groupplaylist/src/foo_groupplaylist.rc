IDD_SORT_BY DIALOGEX 0, 0, 280, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sort by"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Sort the selected tracks by this title formatting pattern:",IDC_STATIC,7,7,266,8
    EDITTEXT        IDC_SORT_PATTERN,7,19,266,13,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,169,41,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,223,41,50,14
END
