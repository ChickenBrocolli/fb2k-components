#include "resource.h"
#include "winres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_COLUMNS_PAGE DIALOGEX 0, 0, 332, 214
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Ticked columns are listed in the Columns menu of the panel header. Built-in columns are locked.",IDC_STATIC,7,4,318,8,SS_NOPREFIX
    CONTROL         "",IDC_COLUMN_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,7,16,262,112
    PUSHBUTTON      "Add",IDC_COLUMN_NEW,275,16,50,14
    PUSHBUTTON      "Duplicate",IDC_COLUMN_DUPLICATE,275,33,50,14
    PUSHBUTTON      "Remove",IDC_COLUMN_DELETE,275,50,50,14
    PUSHBUTTON      "Move up",IDC_COLUMN_UP,275,73,50,14
    PUSHBUTTON      "Move down",IDC_COLUMN_DOWN,275,90,50,14
    GROUPBOX        "Selected column",IDC_STATIC,7,134,318,76
    LTEXT           "Name",IDC_STATIC,15,150,44,8
    EDITTEXT        IDC_COLUMN_NAME,60,148,120,14,ES_AUTOHSCROLL
    LTEXT           "Alignment",IDC_STATIC,192,150,40,8
    COMBOBOX        IDC_COLUMN_ALIGN,235,148,82,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Pattern",IDC_STATIC,15,170,44,8
    EDITTEXT        IDC_COLUMN_PATTERN,60,168,197,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Insert field",IDC_COLUMN_INSERT,261,168,56,14
    LTEXT           "",IDC_COLUMN_PREVIEW,60,188,195,16,SS_NOPREFIX
    CONTROL         "Syntax help",IDC_COLUMN_SYNTAX,"Button",BS_OWNERDRAW | WS_TABSTOP,263,188,54,10
END

IDD_PREFERENCES DIALOGEX 0, 0, 332, 264
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Fonts",IDC_STATIC,7,4,318,52
    AUTOCHECKBOX    "Own font for tracks",IDC_PREF_TRACK_FONT_CUSTOM,15,16,100,10
    PUSHBUTTON      "Choose...",IDC_PREF_TRACK_FONT_BUTTON,120,14,50,14
    LTEXT           "",IDC_PREF_TRACK_FONT_NAME,176,17,145,8,SS_NOPREFIX | SS_ENDELLIPSIS
    AUTOCHECKBOX    "Own font for group headers",IDC_PREF_HEADER_FONT_CUSTOM,15,31,100,10
    PUSHBUTTON      "Choose...",IDC_PREF_HEADER_FONT_BUTTON,120,29,50,14
    LTEXT           "",IDC_PREF_HEADER_FONT_NAME,176,32,145,8,SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT           "Without an own font the panel uses the Default UI playlist font.",IDC_STATIC,15,44,300,8,SS_NOPREFIX
    GROUPBOX        "Colours and sizes",IDC_STATIC,7,60,318,46
    LTEXT           "Group header text",IDC_STATIC,15,74,72,8
    CONTROL         "",IDC_PREF_HEADER_SWATCH,"Static",SS_OWNERDRAW,88,72,22,12
    PUSHBUTTON      "Choose...",IDC_PREF_HEADER_COLOR,114,71,44,14
    LTEXT           "Label text (Disc 1)",IDC_STATIC,170,74,72,8
    CONTROL         "",IDC_PREF_LABEL_SWATCH,"Static",SS_OWNERDRAW,243,72,22,12
    PUSHBUTTON      "Choose...",IDC_PREF_LABEL_COLOR,269,71,44,14
    LTEXT           "Extra row height",IDC_STATIC,15,90,72,8
    EDITTEXT        IDC_PREF_ROW_PADDING,88,88,36,13,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_PREF_ROW_PADDING_SPIN,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,124,88,10,13
    LTEXT           "Album art size",IDC_STATIC,170,90,72,8
    EDITTEXT        IDC_PREF_COVER_SIZE,243,88,36,13,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_PREF_COVER_SIZE_SPIN,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,279,88,10,13
    LTEXT           "px",IDC_STATIC,138,90,20,8
    LTEXT           "px",IDC_STATIC,293,90,20,8
    GROUPBOX        "Rating",IDC_STATIC,7,110,214,30
    LTEXT           "Save ratings in",IDC_STATIC,15,124,72,8
    COMBOBOX        IDC_PREF_RATING,88,122,125,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "Language",IDC_STATIC,227,110,98,30
    COMBOBOX        IDC_PREF_LANGUAGE,235,122,82,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "Scrolling",IDC_STATIC,7,144,318,38
    AUTOCHECKBOX    "Smooth scrolling",IDC_PREF_SMOOTH,15,156,120,10
    AUTOCHECKBOX    "Pin group headers",IDC_PREF_PIN_HEADERS,140,156,170,10
    LTEXT           "Both also switch at once from the menu of a right-click on the column titles.",IDC_STATIC,15,169,300,8,SS_NOPREFIX
    GROUPBOX        "Behaviour",IDC_STATIC,7,186,318,74
    AUTOCHECKBOX    "Remember the group preset of each playlist",IDC_PREF_PRESET_PER_LIST,15,198,300,10
    AUTOCHECKBOX    "Dim text in brackets, such as (Remastered)",IDC_PREF_DIM_BRACKETS,15,210,300,10
    AUTOCHECKBOX    "Sort the playlist by clicking a column header",IDC_PREF_SORT_ON_CLICK,15,222,300,10
    AUTOCHECKBOX    "Remember the scroll position of each playlist",IDC_PREF_SCROLL_PER_LIST,15,234,300,10
    AUTOCHECKBOX    "Bold the playing track",IDC_PREF_BOLD_PLAYING,15,246,300,10
END

IDD_GROUPS_PAGE DIALOGEX 0, 0, 332, 258
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Ways to group a playlist. Ticked presets are listed in the Groups menu of the panel header.",IDC_STATIC,7,4,318,8,SS_NOPREFIX
    CONTROL         "",IDC_PRESET_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,7,16,262,78
    PUSHBUTTON      "Add copy",IDC_PRESET_NEW,275,16,50,14
    PUSHBUTTON      "Remove",IDC_PRESET_DELETE,275,33,50,14
    PUSHBUTTON      "Move up",IDC_PRESET_UP,275,56,50,14
    PUSHBUTTON      "Move down",IDC_PRESET_DOWN,275,73,50,14
    CONTROL         "Syntax help",IDC_PRESET_SYNTAX,"Button",BS_OWNERDRAW | WS_TABSTOP,263,240,54,10
    GROUPBOX        "Selected preset",IDC_STATIC,7,98,318,158
    LTEXT           "Name",IDC_STATIC,15,112,44,8
    EDITTEXT        IDC_PRESET_NAME,62,110,255,14,ES_AUTOHSCROLL
    LTEXT           "Group header",IDC_STATIC,15,130,46,8
    EDITTEXT        IDC_PRESET_HEADER,62,128,195,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Insert field",IDC_PRESET_HEADER_INSERT,261,128,56,14
    LTEXT           "Cover",IDC_STATIC,15,148,46,8
    EDITTEXT        IDC_PRESET_COVER,62,146,195,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Insert field",IDC_PRESET_COVER_INSERT,261,146,56,14
    AUTOCHECKBOX    "Show the cover text next to the cover. A | starts a new line.",IDC_PRESET_COVER_TEXT,62,162,255,10
    LTEXT           "Labels",IDC_STATIC,15,178,46,8
    LTEXT           "one per line",IDC_STATIC,15,188,46,8
    EDITTEXT        IDC_PRESET_SUBGROUPS,62,176,195,28,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL
    PUSHBUTTON      "Insert field",IDC_PRESET_SUBGROUP_INSERT,261,176,56,14
    AUTOCHECKBOX    "Hide a label that is the same for the whole group, such as Disc 1",IDC_PRESET_HIDE_UNIFORM,62,207,255,10
    LTEXT           "Sort by",IDC_STATIC,15,223,46,8
    EDITTEXT        IDC_PRESET_SORT,62,221,195,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Insert field",IDC_PRESET_SORT_INSERT,261,221,56,14
    LTEXT           "",IDC_PRESET_PREVIEW,62,238,195,16,SS_NOPREFIX
END
